# Port for the Express server
PORT=3000

# OPTION 1: Full JSON content of your service account (Recommended for Render/Koyeb)
# Paste the entire content of serviceAccountKey.json as a single line here
SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "..." }

# OPTION 2: Path to your Firebase Service Account JSON file (Used locally)
# GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
