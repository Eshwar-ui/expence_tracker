rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if document belongs to current user via field
    function belongsToUser(data) {
      return isAuthenticated() && data.userId == request.auth.uid;
    }
    
    // ============================================================
    // USERS COLLECTION
    // ============================================================
    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Expenses subcollection under users
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ============================================================
    // BUDGETS COLLECTION
    // ============================================================
    // Users can only access their own budgets
    // Note: For queries, Firestore checks each document returned
    // The .where('userId', isEqualTo: _userId) filter ensures only user's docs are returned
    match /budgets/{budgetId} {
      allow read: if belongsToUser(resource.data);
      allow create: if belongsToUser(request.resource.data);
      allow update: if belongsToUser(resource.data) && belongsToUser(request.resource.data);
      allow delete: if belongsToUser(resource.data);
    }
    
    // ============================================================
    // BUDGET_PLANS COLLECTION
    // ============================================================
    // Users can only access their own budget plans
    match /budget_plans/{planId} {
      allow read: if belongsToUser(resource.data);
      allow create: if belongsToUser(request.resource.data);
      allow update: if belongsToUser(resource.data) && belongsToUser(request.resource.data);
      allow delete: if belongsToUser(resource.data);
    }
    
    // ============================================================
    // RECURRING_TRANSACTIONS COLLECTION
    // ============================================================
    // Users can only access their own recurring transactions
    match /recurring_transactions/{transactionId} {
      allow read: if belongsToUser(resource.data);
      allow create: if belongsToUser(request.resource.data);
      allow update: if belongsToUser(resource.data) && belongsToUser(request.resource.data);
      allow delete: if belongsToUser(resource.data);
    }
    
    // ============================================================
    // EXPENSES COLLECTION (Top-level - for backward compatibility)
    // ============================================================
    // Note: This is used by BudgetService.calculateSpentForCategory
    // Users can only access expenses with their userId
    match /expenses/{expenseId} {
      // Allow read if user owns the document
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow update if user owns the document
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      
      // Allow delete if user owns the document
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow create if userId matches authenticated user
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // ============================================================
    // DENY ALL OTHER ACCESS
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
