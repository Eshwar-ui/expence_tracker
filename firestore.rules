rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function belongsToUser(data) {
      return isAuthenticated() && data.userId == request.auth.uid;
    }

    // Validate expense / income document shape
    function isValidExpense(data) {
      return data.userId == request.auth.uid
          && data.amount is number
          && data.amount > 0
          && data.amount < 100000000
          && data.category is string
          && data.category.size() > 0
          && data.category.size() < 100;
    }

    function isValidBudget(data) {
      return data.userId == request.auth.uid
          && data.limit is number
          && data.limit >= 0
          && data.category is string
          && data.category.size() > 0;
    }

    // ============================================================
    // USERS COLLECTION (current data layout)
    // ============================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Each subcollection is listed explicitly. No catch-all.
      match /expenses/{expenseId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidExpense(request.resource.data);
      }

      match /budgets/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidBudget(request.resource.data);
      }

      match /budget_plans/{planId} {
        allow read, write: if isOwner(userId);
      }

      match /recurring_transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      match /pending_transactions/{pendingId} {
        allow read, write: if isOwner(userId);
      }

      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /analytics/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================================
    // LEGACY ROOT-LEVEL COLLECTIONS (kept for backward compatibility)
    // ============================================================

    match /budgets/{budgetId} {
      allow read: if belongsToUser(resource.data);
      allow create: if belongsToUser(request.resource.data) && isValidBudget(request.resource.data);
      allow update: if belongsToUser(resource.data) && isValidBudget(request.resource.data);
      allow delete: if belongsToUser(resource.data);
    }

    match /budget_plans/{planId} {
      allow read: if belongsToUser(resource.data);
      allow create: if belongsToUser(request.resource.data);
      allow update: if belongsToUser(resource.data) && belongsToUser(request.resource.data);
      allow delete: if belongsToUser(resource.data);
    }

    match /recurring_transactions/{transactionId} {
      allow read: if belongsToUser(resource.data);
      allow create: if belongsToUser(request.resource.data);
      allow update: if belongsToUser(resource.data) && belongsToUser(request.resource.data);
      allow delete: if belongsToUser(resource.data);
    }

    match /expenses/{expenseId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidExpense(request.resource.data);
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && isValidExpense(request.resource.data);
    }
  }
}
