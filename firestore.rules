rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if document belongs to current user via field
    function belongsToUser(data) {
      return isAuthenticated() && data.userId == request.auth.uid;
    }
    
    // ============================================================
    // USERS COLLECTION
    // ============================================================
    // Users can only read/write their own user document and all subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Expenses subcollection under users
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }
      
      // Budgets subcollection under users
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }
      
      // Budget plans subcollection under users
      match /budget_plans/{planId} {
        allow read, write: if isOwner(userId);
      }
      
      // Recurring transactions subcollection under users
      match /recurring_transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
      
      // Categories subcollection under users
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ============================================================
    // LEGACY: ROOT-LEVEL COLLECTIONS (for backward compatibility)
    // ============================================================
    // These can be removed once all data is migrated to subcollections
    
    // Budgets at root level (legacy)
    match /budgets/{budgetId} {
      allow read: if belongsToUser(resource.data);
      allow create: if belongsToUser(request.resource.data);
      allow update: if belongsToUser(resource.data) && belongsToUser(request.resource.data);
      allow delete: if belongsToUser(resource.data);
    }
    
    // Budget plans at root level (legacy)
    match /budget_plans/{planId} {
      allow read: if belongsToUser(resource.data);
      allow create: if belongsToUser(request.resource.data);
      allow update: if belongsToUser(resource.data) && belongsToUser(request.resource.data);
      allow delete: if belongsToUser(resource.data);
    }
    
    // Recurring transactions at root level (legacy)
    match /recurring_transactions/{transactionId} {
      allow read: if belongsToUser(resource.data);
      allow create: if belongsToUser(request.resource.data);
      allow update: if belongsToUser(resource.data) && belongsToUser(request.resource.data);
      allow delete: if belongsToUser(resource.data);
    }
    
    // Expenses at root level (legacy)
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
    }
  }
}
